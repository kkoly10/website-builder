{
  "$comment": "CrecyStudio design tokens. Mirror of brand/tokens.css — keep tokens.css, tokens.json and BRAND.md in step. Colours are anchored in the logo masters (crecysstudio svglogo.zip).",
  "color": {
    "ink":            { "value": "#1a1210", "use": "Headlines, primary text, dark panels" },
    "ink2":           { "value": "#33251f", "use": "Body copy on light" },
    "ink3":           { "value": "#5c4a42", "use": "Supporting copy" },
    "muted":          { "value": "#76675d", "use": "Labels, captions, footer links", "contrast": { "onPaper": 5.26, "onPaper3": 4.51 } },
    "muted2":         { "value": "#958378", "use": "Large text and UI only — never body", "contrast": { "onPaper": 3.51 } },
    "brandTaupe":     { "value": "#8a7d74", "use": "Logo wordmark only. Fails AA for small text.", "source": "crecy-d1-horizontal-light.svg" },

    "accent":         { "value": "#c43e2b", "use": "Primary brand accent, used sparingly", "source": "crecy-icon.svg", "contrast": { "onPaper": 5.00, "whiteOn": 5.16 } },
    "accent600":      { "value": "#a83324", "use": "Hover / pressed" },
    "accent700":      { "value": "#8c2a1e", "use": "Accent text on --wash" },
    "accent300":      { "value": "#e8907f", "use": "Rules, quiet marks on dark" },
    "accentOnInk":    { "value": "#d55340", "use": "Accent text on dark panels", "contrast": { "onInk": 4.52 } },
    "wash":           { "value": "#fbf0ec", "use": "Tinted card / badge background" },

    "paper":          { "value": "#fdfbf9", "use": "Page canvas. Never pure white." },
    "paper2":         { "value": "#f7f3ef", "use": "Section break" },
    "paper3":         { "value": "#efe9e3", "use": "Tertiary surface" },
    "surface":        { "value": "#ffffff", "use": "Cards and fields, above the canvas" },

    "rule":           { "value": "#e7ded7", "use": "Hairlines" },
    "rule2":          { "value": "#d5c8bf", "use": "Stronger borders" },
    "ruleOnInk":      { "value": "rgba(253, 251, 249, 0.16)", "use": "Hairlines on dark panels" },

    "success":        { "value": "#2f6d3a" },
    "successWash":    { "value": "#e9f2e7" },
    "warning":        { "value": "#9a6212" },
    "warningWash":    { "value": "#fbf1e0" },
    "error":          { "value": "#b3261e" },
    "errorWash":      { "value": "#fbeae8" }
  },
  "font": {
    "display":  { "value": "Fraunces", "use": "Marketing headlines ONLY. Never in portal or admin." },
    "body":     { "value": "Manrope",  "use": "Body, UI, forms — everything else" },
    "wordmark": { "value": "Sora",     "use": "The logo and nothing else", "source": "logo masters" }
  },
  "type": {
    "h1":      { "size": "clamp(2.9rem, 5.2vw, 4.6rem)",   "leading": 1.02, "tracking": "-0.03em" },
    "h2":      { "size": "clamp(2.1rem, 3.6vw, 3.1rem)",   "leading": 1.06, "tracking": "-0.026em" },
    "h3":      { "size": "clamp(1.25rem, 1.8vw, 1.5rem)",  "leading": 1.24, "tracking": "-0.016em" },
    "lede":    { "size": "clamp(1.06rem, 1.25vw, 1.22rem)","leading": 1.62 },
    "body":    { "size": "16px",   "leading": 1.68 },
    "small":   { "size": "14px",   "leading": 1.55 },
    "caption": { "size": "12.5px", "leading": 1.45 }
  },
  "radius": { "sm": "6px", "md": "9px", "lg": "12px", "xl": "16px", "pill": "999px" },
  "space":  { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "40px", "8": "64px", "9": "80px", "10": "96px", "11": "128px" },
  "shadow": {
    "sm": "0 1px 2px rgba(26, 18, 16, 0.05)",
    "md": "0 4px 14px rgba(26, 18, 16, 0.07)",
    "lg": "0 14px 34px -12px rgba(26, 18, 16, 0.16)",
    "xl": "0 28px 60px -30px rgba(26, 18, 16, 0.28)"
  },
  "layout": { "gutter": "clamp(20px, 4.5vw, 56px)", "maxw": "1280px", "maxwProse": "68ch" },
  "motion": { "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)", "durFast": "0.16s", "dur": "0.24s" }
}
